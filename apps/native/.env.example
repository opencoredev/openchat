# Convex deployment URL (copy from apps/server setup or your Convex dashboard)
# Local dev: http://localhost:3210
# Production: https://your-project.convex.cloud
EXPO_PUBLIC_CONVEX_URL=http://localhost:3210

# Better Auth base URL — points to your Convex site URL
# This is the same as VITE_CONVEX_SITE_URL in the web app
# Local dev: http://localhost:3210
# Production: https://your-project.convex.site
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:3210
